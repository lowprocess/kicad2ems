+    @staticmethod
+    def _existing(dim: int, tags: list[int]) -> list[int]:
+        """The tags of entities that still exist: gmsh 4.15 throws on a mesh field listing a removed one
+        (4.14 ignored it), from inside mesh generation, which aborts the process."""
+        have = {t for _, t in gmsh.model.getEntities(dim)}
+        return [t for t in tags if t in have]
